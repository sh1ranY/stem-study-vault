# Optional. All three original course demos work with all values blank.
# Copy this file to .env; keep .env private. Restart the backend after changes.
STUDIO_PROVIDER=
# Explicit model identifier supporting the provider's Chat Completions JSON mode.
STUDIO_MODEL=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Optional absolute directory for local application data:
# STUDIO_DATA_DIR=

# Multi-course pilot: image transcription and feedback use OpenAI Responses.
# Use an image-capable model ID available to your account. No key goes into the browser.
STUDIO_VISION_MODEL=
# SQLite is the local default; optional PostgreSQL DSN:
# STUDIO_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
STUDIO_DAILY_MODEL_CALLS=30
# Set only after deploying HTTPS and completing deployment permission tests.
STUDIO_COOKIE_SECURE=0
# Optional source roots on a different computer:
# STUDIO_VAULT_ROOT=/absolute/path/to/Obsidian
# STUDIO_ELEC270_SOURCES=/absolute/path/to/ELEC270-sources

# Local remains the default. Hosted startup requires exact HTTPS origin + persistent storage.
STUDIO_DEPLOYMENT=local
# STUDIO_PUBLIC_ORIGIN=https://your-service.onrender.com
# STUDIO_BOOTSTRAP_TOKEN=generate-a-private-random-value-of-at-least-32-characters
# STUDIO_MAX_USERS=10
# STUDIO_PHOTO_QUOTA_BYTES=104857600

# STUDIO_COMP201_SOURCES=/absolute/path/to/COMP201-sources
# STUDIO_COMP207_SOURCES=/absolute/path/to/COMP207-sources
